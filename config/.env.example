# 환경 변수 설정 (Environment Variables)
# 이 파일을 .env로 복사하고 실제 값으로 채워주세요

# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
CODEX_MODEL=code-davinci-002

# 작업공간 설정
WORKSPACE_PATH=C:\emosion
PROJECT_NAME=emosion_vedio

# 비디오 처리 설정
VIDEO_OUTPUT_DIR=videos/output
TEMP_DIR=temp

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=logs/emosion.log